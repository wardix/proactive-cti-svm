APP_NAME="proactive-cti-svm"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000

# Database Configuration (Supports 'sqlite' out-of-the-box or 'mysql' using database/schema.sql)
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

# Uncomment below to use MySQL:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=cti_svm_defense
# DB_USERNAME=root
# DB_PASSWORD=

# Python SVM Machine Learning Microservice URL
ML_SERVICE_URL=http://127.0.0.1:8001

# Real CTI Sources Configuration (MISP, Wazuh, Honeypot)
MISP_BASE_URL=https://misp.local
MISP_API_KEY=your_misp_rest_api_key_here
MISP_VERIFY_SSL=false

WAZUH_BASE_URL=https://wazuh.local:55000
WAZUH_API_USER=wazuh-wui
WAZUH_API_PASSWORD=wazuh-password
WAZUH_VERIFY_SSL=false

HONEYPOT_LOG_URL=http://honeypot.local:9000/logs
HONEYPOT_SENSOR_TYPE=Cowrie
